<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net48</TargetFrameworks>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <Import Project="LibraryTargetFramework.props" />

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.5.1" />
  </ItemGroup>

  <!-- The second process in the two-process tests. It builds into peer\ in this project's output folder. -->
  <ItemGroup>
    <ProjectReference Include="..\SharedMemory.Tests.Peer\SharedMemory.Tests.Peer.csproj" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=$(TargetFramework)" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net48</TargetFrameworks>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- The library build under test. With -f net48, pass -p:LibraryTargetFramework=net4 or net35 to test those builds. -->
  <PropertyGroup>
    <LibraryTargetFramework Condition="'$(LibraryTargetFramework)' == '' and '$(TargetFramework)' == 'net10.0'">netstandard2.1</LibraryTargetFramework>
    <LibraryTargetFramework Condition="'$(LibraryTargetFramework)' == '' and '$(TargetFramework)' == 'net48'">net47</LibraryTargetFramework>
    <DefineConstants Condition="'$(LibraryTargetFramework)' != 'net4' and '$(LibraryTargetFramework)' != 'net35'">$(DefineConstants);HAS_RPC_BUFFER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharedMemory\SharedMemory.csproj" SetTargetFramework="TargetFramework=$(LibraryTargetFramework)" />
  </ItemGroup>

</Project>
